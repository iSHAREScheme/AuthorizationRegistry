# --- HTTP server ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL=postgresql://ar:ar@localhost:5432/authorization_registry?schema=public

# --- This Authorization Registry's iSHARE party identity ---
PARTY_CLIENT_ID=EU.EORI.NL000000004
PARTY_NAME=Authorization Registry

# --- Digital Signer (RSA private key + public cert chain in PEM) ---
# The PEM strings below MUST keep their literal "\n" line separators when stored
# as a single-line env var. The application normalizes them at startup.
DIGITAL_SIGNER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Leaf certificate (base64 DER, no headers / line breaks). Used as first entry in x5c.
DIGITAL_SIGNER_CERT_X5C_LEAF=MIIE...
# Optional comma-separated intermediate + root certs (same encoding), appended after leaf.
DIGITAL_SIGNER_CERT_X5C_CHAIN=

# --- iSHARE Scheme Owner ---
SCHEME_OWNER_BASE_URL=https://so.scheme.example/
SCHEME_OWNER_CLIENT_ID=EU.EORI.NL000000000
# Public key (base64 DER) used to validate Scheme Owner-issued JWTs.
SCHEME_OWNER_PUBLIC_KEY=MIIE...

# --- Issued access token lifetime (seconds) ---
ACCESS_TOKEN_TTL_SECONDS=3600
RESPONSE_JWT_TTL_SECONDS=30

# --- Bypass response signing (dev only) by sending header `Do-Not-Sign: true`
ALLOW_DO_NOT_SIGN_HEADER=true
